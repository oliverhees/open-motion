# Open Motion – configuration for Docker / Coolify
# Copy: cp .env.example .env  and fill in the values.

# Required: password for the editor (16+ characters recommended)
OPENMOTION_PASSWORD=

# Optional: local Whisper in the render worker (bigger image): slim | whisper
OPENMOTION_WORKER_VARIANT=slim

# Optional: cookie only over HTTPS (1 = yes, 0 = local without HTTPS)
OPENMOTION_COOKIE_SECURE=1

# Optional: debug log of all API responses to /data/logs (without keys)
OPENMOTION_DEBUG=0

# Provider API keys (OpenAI, Anthropic, Kie.ai …) are entered in the editor under ⚙ Settings.
# They are stored with file mode 600 in the data volume and never sent to the browser.
